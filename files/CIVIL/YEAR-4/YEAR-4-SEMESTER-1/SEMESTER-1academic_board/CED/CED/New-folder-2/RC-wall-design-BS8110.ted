nput("Design ultimate axial load per m of wall","n_\{w\}","kN/m","",1) }{\fldrslt }};\tab Axial load per m of wall; n{\sub w} = {\field\fldlock{\*\fldinst =CSC|?f1}{\*\fldrslt\fs18\b\f1\cf1 1.0}} kN/m\par {\field\fldlock{\*\fldinst  =CSC|CALL input("Design moment per m of wall at position of shear check","m_\{w\}","kNm/m","",1) }{\fldrslt }};\tab Major axis moment per m of wall; m{\sub w} = {\field\fldlock{\*\fldinst =CSC|?f1}{\*\fldrslt\fs18\b\f1\cf1 5627.0}} kNm/m\par \tab e = m{\sub w} / n{\sub w} = {\field\fldlock{\*\fldinst =CSC|?f1}{\*\fldrslt\fs18\b\f1\cf1 5627000.0}} mm\par \tab e{\sub limit} = 0.6 {\f31587 \'b4} h = {\field\fldlock{\*\fldinst =CSC|?f1}{\*\fldrslt\fs18\b\f1\cf1 420.0}} mm\par \pard\plain \s18 \li720\ri2232\sb72\sa72\widctlpar\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tqr\tx11520 \f1\fs18\lang1024 Actual shear stress; v{\sub x} = v{\sub w} / h' = {\field\fldlock{\*\fldinst =CSC|?f1}{\*\fldrslt\fs18\b\f1\cf1 1.1}} N/mm{\super 2}\par Allowable stress; v{\sub allowable} = min ((0.8 N{\super 1/2}/mm) {\f31587 \'b4} {\f31587 \'d6}(f{\sub cu }), 5 N/mm{\super 2} ) = {\field\fldlock{\*\fldinst =CSC|?f3}{\*\fldrslt\fs18\b\f1\cf1 4.382}} N/mm{\super 2} \par \pard\plain \s40 \qr\li8064\ri72\sb144\sa144\widctlpar\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\tx9360\tx10080\tx10800\tqr\tx11520 \b\i\f1\lang1024 {\field\fldlock{\*\fldinst  =CSC|CALL show(if(abs(v_\{x\})>v_\{allowable\}, "Shear check required",if(e>e_\{limit\},"Shear check required","No shear check required"))) }{\fldrslt \fs18\b\f1\cf1{Shear check required}}}\par }}}{\insrsid7304486 {\field\fldlock{\*\fldinst =CSC|ERROR}{\*\fldrslt\fs18\b\f1\cf6 <Error: unknown error>}};\par }}}}{\insrsid7304486 ;\par }}}]]></Text>
