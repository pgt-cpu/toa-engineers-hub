\par }{\insrsid12665748 Nominal cover for very moderate conditions of exposure = 25mm
\par Nominal cover for 1.5 hours fire resistance = 20mm
\par Since 25>20, provide nominal cover = 25mm
\par Therefore durability and fire resistance are satisfactory.
\par 
\par }\pard \qc \li0\ri0\widctlpar\intbl\aspalpha\aspnum\faauto\adjustright\rin0\lin0\pararsid12665748\yts15 {\ul\insrsid12665748 Preliminary Sizing of Beam}{\ul\insrsid12665748\charrsid8221855 
\par }\pard \ql \li0\ri0\widctlpar\intbl\aspalpha\aspnum\faauto\adjustright\rin0\lin0\pararsid12665748\yts15 {\insrsid12665748 
\par Basic span/ effective depth (d) <26*1=26    Modification factor =1
\par d>span /26
\par }{\insrsid15610189 Minimum effective depth = 3800/26 =146.15}{\insrsid12665748 mm
\par Assuming R12 bars D = d + concrete cover+ (bar diameter/2)
\par          }{\insrsid15610189                        D = 146.15 + 25 + 6 =177.15}{\insrsid12665748 mm
\par }\pard \qc \li0\ri0\widctlpar\intbl\aspalpha\aspnum\faauto\adjustright\rin0\lin0\pararsid12665748\yts15 {\ul\insrsid12665748 Design decisions}{\ul\insrsid12665748\charrsid2579406 
\par }\pard \ql \li0\ri0\widctlpar\intbl\aspalpha\aspnum\faauto\adjustright\rin0\lin0\pararsid12665748\yts15 {\insrsid12665748 Choose  D = 450mm
\par Choose R8 as links bar
\par Choose  R12 as reinforcement bar
\par 
\par Therefore, d}{\sub\insrsid12665748\charrsid14042993 1}{\insrsid12665748  = 450-25-6-8=411mm
\par 
\par }\pard \qc \li0\ri0\widctlpar\intbl\aspalpha\aspnum\faauto\adjustright\rin0\lin0\pararsid12665748\yts15 {\ul\insrsid12665748 Loading}{\ul\insrsid12665748\charrsid3880709 
