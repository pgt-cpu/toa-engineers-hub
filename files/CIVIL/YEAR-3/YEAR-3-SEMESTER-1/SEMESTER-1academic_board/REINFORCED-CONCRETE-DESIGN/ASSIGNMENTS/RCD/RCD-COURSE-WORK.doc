\insrsid8016097 
\par                 N}{\sub\insrsid8016097\charrsid5310788 1}{\insrsid8016097 =  \'bd*(6.3*}{\insrsid8940741 1}{\insrsid8016097 8}{\insrsid8940741 .26)=57.52}{\insrsid8016097 KN
\par Loading on column due to beam A}{\sub\insrsid8016097\charrsid5310788 2}{\insrsid8016097 
\par                  N}{\sub\insrsid8016097\charrsid5310788 2}{\insrsid8016097 = \'bd*}{\insrsid8940741 14.87}{\insrsid8016097 *3.}{\insrsid8940741 8=28.25}{\insrsid8016097 KN
\par Self weight of column
\par                   N}{\sub\insrsid8016097\charrsid5310788 3}{\insrsid8016097 = (0.3*0.45*24*3.075)*1.4=13.95KN
\par Total axial lo}{\insrsid8940741 ad on second floor=(13.95+57.52+28.25)=99.723KN}{\insrsid8016097 
\par }{\ul\insrsid8016097\charrsid5310788 
\par Design }{\ul\insrsid8940741 of first}{\ul\insrsid8016097\charrsid5310788  floor column}{\ul\insrsid8016097 
\par 
\par }{\insrsid8016097 Total }{\insrsid8940741 axial load =99.723KN}{\insrsid8016097 
\par N=0.4fcuAc+0.75fyAsc
\par For rectangular column to allow for the area of concrete displayed by longitudinal reinforcement.
\par Modified formula N =0.4fcubh +Asc(0.75fy-0.4fcu)
\par Ac is the net area of concrete
\par Asc is the area of longitudinal reinforcement
\par Therefore Asc =(N-0.4fcubh)/(0.75fy-0.4fcu)
\par }{\insrsid8940741 Asc =(99.723*1}{\insrsid8016097 0}{\super\insrsid8016097\charrsid8983990 3}{\insrsid8016097 -0.4*30*300*450)/[(0.75*250)-(0.4*30)]
\par }{\insrsid8940741 Asc =-8662.55}{\insrsid8016097 mm}{\super\insrsid8016097\charrsid8983990 2}{\insrsid8016097 
\par 
\par The negative sign indicates that compression reinforcement is not required since N<0.4*fcubh
\par  
\par }{\i\insrsid8016097\charrsid8538432 Hence provide nominal reinforcement.
\par }\pard \qc \li0\ri0\widctlpar\intbl\aspalpha\aspnum\faauto\adjustright\rin0\lin0\pararsid9768934\yts15 {\i\fs28\insrsid9768934\charrsid8538432 
\par }\pard \ql \li0\ri0\widctlpar\intbl\aspalpha\aspnum\faauto\adjustright\rin0\lin0\pararsid2818948\yts15 {\i\insrsid2818948\charrsid8538432 In the design of the ground floor}{\i\insrsid2716809\charrsid8538432  columns}{\i\insrsid2818948\charrsid8538432 
 the net axial loading will increase and it will be the total sum of the axial loading from the 1}{\i\super\insrsid2818948\charrsid8538432 st}{\i\insrsid2818948\charrsid8538432  floor and the axial loads of the ground floor}{\b\insrsid2818948 .
\par }\pard \qc \li0\ri0\widctlpar\intbl\aspalpha\aspnum\faauto\adjustright\rin0\lin0\pararsid2716809\yts15 {\b\ul\insrsid2716809\charrsid2716809 
