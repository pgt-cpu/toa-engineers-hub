\par }{\insrsid1706395 Loading of column due ot beam A}{\sub\insrsid1706395\charrsid5310788 1}{\insrsid1706395 
\par                 }{\insrsid5310788 N}{\sub\insrsid5310788\charrsid5310788 1}{\insrsid5310788 = }{\insrsid1706395  \'bd*(6.3*}{\insrsid5310788 10.8)=34.02KN}{\insrsid1706395 
\par }{\insrsid5310788 Loading on column due to beam A}{\sub\insrsid5310788\charrsid5310788 2}{\insrsid5310788 
\par                  N}{\sub\insrsid5310788\charrsid5310788 2}{\insrsid5310788 = \'bd*8.33*3.8=15.827KN
\par Self weight of column
\par                   N}{\sub\insrsid5310788\charrsid5310788 3}{\insrsid5310788 = (0.3*0.45*24*3.075)*1.4=13.95KN
\par Total axial load on second floor=(13.95+15.827+34.02)=63.80KN
\par }{\ul\insrsid5310788\charrsid5310788 
\par Design of second floor column}{\ul\insrsid5310788 
\par 
\par }{\insrsid5310788 Total axial load =63.80KN
\par N=0.4fcuAc+0.75fyAsc
\par For }{\insrsid13921556 rectangular column to allow f}{\insrsid5310788 or t}{\insrsid13921556 he area of concrete displayed b}{\insrsid5310788 y longitudinal reinforcement.
\par }{\insrsid13921556 Modified formula N =0.4fcubh +Asc(0.75fy-0.4fcu)
\par Ac is the net area of concrete
\par Asc is the area of longitudinal reinforcement
\par Therefore Asc =(N-0.4fcubh)/(0.75fy-0.4fcu)
\par }{\insrsid8983990 Asc =(63.80*10}{\super\insrsid8983990\charrsid8983990 3}{\insrsid8983990 -0.4*30*300*450)/[(0.75*250)-(0.4*30)]}{\insrsid13921556 
\par }{\insrsid8983990 Asc =-8871.79mm}{\super\insrsid8983990\charrsid8983990 2}{\insrsid8983990 
\par 
\par The negative sign indicates that compression reinforcement is not required since N<0.4*fcubh
\par  
\par }{\b\insrsid8983990\charrsid8016097 Hence provide nominal reinforcement.
