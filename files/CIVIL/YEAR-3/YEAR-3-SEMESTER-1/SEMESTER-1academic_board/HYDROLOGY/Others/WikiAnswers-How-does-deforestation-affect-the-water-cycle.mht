/************** css for rounded corners with bullets ***************/
.rc-css {
 position:relative;
 margin: 0;
 text-align:center;
 width:100%;
 height:auto;
 text-align:center;
}
.tl-c,.bl-c,.tr-c,.br-c,.tl-c10,.bl-c10,.tr-c10,.br-c10{
	position:absolute;
	width:20px;
	height:20px;
	background-color:#FFF;
	overflow:hidden;
	*z-index:-1;

}
.tl-dot,.bl-dot,.tr-dot,.br-dot,.tl-dot10,.bl-dot10,.tr-dot10,.br-dot10{
	position:relative;
	font-size:150px;
	font-family:arial;
	line-height: 40px;
}

.tl-c,.tl-c10{top:0; left:0;}
.bl-c,.bl-c10{bottom:0; left:0;}
.tr-c,.tr-c10{top:0; right:0;}
.br-c,.br-c10{bottom: 0; right:0;}

.tl-dot{left:-8px;}
.bl-dot{left:-8px; top:-17px;}
.tr-dot{left:-25px;}
.br-dot{left:-25px; top:-17px;}

.rc-content {
 position: relative;
 padding: 4px;
 color:#000;
 text-align:left;
 margin:10px auto;
 height:auto;
 width:auto;
}

.tl-dot10,.bl-dot10,.tr-dot10,.br-dot10{font-size:75px;line-height:20px;}
.tl-c10,.bl-c10,.tr-c10,.br-c10{width:10px;height:10px;}
.tl-dot10{left:-4px;}
.bl-dot10{left:-4px; top:-8.5px;}
.tr-dot10{left:-12.5px;}
.br-dot10{left:-12.5px; top:-8.5px;}

.ffffff{background-color:#ffffff;color:#ffffff;text-align:center;margin:0 auto;height:auto;width:100%;}

.ffffff .rc-content{text-align:left;margin:0 auto;padding:3px;}
.IEold .ffffff .rc-content{padding:4px;}
.rc-inner{height:auto;text-align:center;margin:0 auto;padding:3px;}
.rc-full{z-index:2}

/************** end of css for rounded corners with bullets ***************/

/************** specific classes for the css rounded corners  ***************/
.d4e996{background-color:#d4e996;color:#d4e996 }
.d4e996 .ffffff .tl-c10,.d4e996 .ffffff .bl-c10,.d4e996 .ffffff .tr-c10,.d4e996 .ffffff .br-c10{background-color:#d4e996;}
.becde6{background-color:#becde6;color:#becde6 }
.becde6 .ffffff .tl-c10,.becde6 .ffffff .bl-c10,.becde6 .ffffff .tr-c10,.becde6 .ffffff .br-c10{background-color:#becde6;}
.fdc588{background-color:#fdc588;color:#fdc588 }
.fdc588 .ffffff .tl-c10,.fdc588 .ffffff .bl-c10,.fdc588 .ffffff .tr-c10,.fdc588 .ffffff .br-c10{background-color:#fdc588;}
.fbf092{background-color:#fbf092;color:#fbf092 }
.fbf092 .ffffff .tl-c10,.fbf092 .ffffff .bl-c10,.fbf092 .ffffff .tr-c10,.fbf092 .ffffff .br-c10{background-color:#fbf092;}
.e5e5e4{background-color:#e5e5e4;color:#e5e5e4 }
.e5e5e4 .ffffff .tl-c10,.e5e5e4 .ffffff .bl-c10,.e5e5e4 .ffffff .tr-c10,.e5e5e4 .ffffff .br-c10{background-color:#e5e5e4;}
/************** end of specific classes for the css rounded corners  ***************/
