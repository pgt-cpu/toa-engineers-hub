/********
	Float
		**********/
.floatwrapper:after {
	content:".";
	display:block;
	height:0;
	clear:both;
	visibility:hidden;
}
.floatwrapper {display:inline-block;}
/* Hide from IE Mac \*/
	.floatwrapper {display:block;}
/* End hide from IE Mac */
.floatleft{
	float:left;
}
.floatright{
	float:right;
}
.clear{
	clear:both;
}
*
{
	padding:0;
}
/********
	Base Styles
		**********/
/* see faqArticle */
.onlyleft {
 padding:0;
 margin:0;
 text-align:left;
 }

img{border:none;}
h1,h2,h3,h4,h5,p,ul,ol{
	margin:0;
	padding:0;
}
a, a:visited, a:active, a:hover{
	color:#003399;
	text-decoration:none;
}

a:hover {
	text-decoration:underline;
}

:-moz-any-link:focus {
  outline: none;
}
a {
 	outline: none;
}
body{
	text-align:center;
	margin:0;
	padding:0;
	color:#000;
	font-size:12px;
	font-family: Verdana, sans-serif;
	position:relative;
	background-color:#FFF;
}
.status{
	background-color:#FFFF66;
    font-size:14px;
    display:inline-block;
    margin-bottom: 5px;
    width: 100%;
    text-align:center;
}
.STATUS{ /* .status and .STATUS should be merged. The names are not equivalent same in DTD XHTML 1.0 Strict */
	background-color:#FFFF66;
    font-size:14px;
    display:inline-block;
    margin-bottom: 5px;
    width: 100%;
    text-align:center;
}
/* oaoa TODO: this is used for smaller status, since I didn't want to change the previous .STATUS block and
   mess other status messages up. This can probably be removed */
.SMALLSTATUS{
	width: 979px;
    font-size:12px;
    padding:5px;
}
.highlight{
	background-color:#FFFF66;
}
.small{
	font-size:10px;
}
#container{
	width:989px;
	margin: 10px auto 20px;
}

/********
	Header
		**********/
#header{
    position:relative;
    text-align:left;
    margin-bottom:3px;
    z-index:5;
}
#header ul{
	position:absolute;
	right:0;
	top:29px;
	font-size:11px;
}
#header ul li{
	list-style-type: none;
	float:left;
	padding: 0 8px 0 5px;
	position: relative;
    color:#003399;
    cursor:pointer;
}
#header ul li.last{
	border:none;
}
#header a{
	text-decoration:none;
}
#header li ul {
  display: none;
  position: absolute;
  background:#FFF;
  border:1px solid #B2C5CC;
  top: auto;
  left: auto;
  z-index:10;
}
#header li #RADD{
    margin-right:5px;
    width:93px;
}
#header li #WADD{
    margin-right:-19px;
    width:140px;
}
#header li #LLDD{
    margin-right:-1px;
    width:70px;
}
.IE #header li #RADD, .IE #header li #WADD, .IE #header li #LLDD{
	top: 15px;
    left: 4px;

}
#header ul li ul li{
  padding:3px 3px;
  float:none;
}
#header ul li ul li a{
	display:block;
	width:100%;
}
#header ul li ul li:hover,
#header ul li ul li.sfhover
{
	background-color:#EFF2F9;
}

/********
	Ask/Answer Bar
		**********/
#ask-answer{
	margin-top:13px;
	text-align:left;
	position:relative;
}
#ask-answer #ask-answer-nav{
	position:absolute;
	top:-10px;
	left:0;
}
#ask-answer #ask-answer-nav li{
	padding: 0px;
	border: none;
	margin: 0px;
}
#ask-answer #ask-answer-nav li a{
	padding: 0px;
	margin: 0px;
	display:block;
	width:198px;
	margin-bottom:13px;
	height:66px;
	font-size:30px;
	color:#FFF;
	text-decoration:none;
	line-height:60px;
	padding-left:20px;
}
#ask-answer #ask-answer-nav li.ask {
	padding: 0px;
    margin: 0px;
}
#ask-answer #ask-answer-nav li.answer {
	padding: 0px;
	margin: 0px;
}
/* remove these two following */
#ask-answer .question-bar{
	float:right;
	font-size:18px;
	color:#FFF;
	display:none;
    width: 744px;
}
#ask-answer .question-bar .border{
	margin:1px;
	border:solid 1px #FFF;
	padding:10px 20px 20px 20px;
	height:108px;
	width:700px;
}
#ask-answer .question-bar.answer .border a{
    color: #FFFFFF;
}
#ask-answer .question-bar input.question{
	font-size:30px;
	margin-top:13px; /* changed - was 15 */
    padding-top: 2px;
    padding-bottom: 2px; /* added */
	float:left;
	height:37px;
	width:575px;
}
#ask-answer .question-bar #rawaradio{
	float:right;
	font-size:11px;
	height:20px;
	margin-top:2px;
	position:relative;
	right:26px;
	width:265px;
	top:10px;
}
.IE #ask-answer .question-bar #rawaradio span{
	zoom:1;
}
#ask-answer .question-bar #rawaradio input,
#container #ask-answer .question-bar .rawaradio2 input{
	position:relative;
	top:3px;
	*top:2px;
	left:5px;
	margin-left:10px;
	*margin-left:0;
}
.IE8 #ask-answer .question-bar #rawaradio input,
.IE8 #container #ask-answer .question-bar .rawaradio2 input{
	margin-right:3px;
}
#container #ask-answer .question-bar .rawaradio2{
	width:305px;
	*width:318px;
}
#ask-answer ul{
	clear:left;
	padding-top:10px;
}
#ask-answer ul li{
	display:inline;
	font-size:10px;
	border-right:solid 1px #FFF;
	padding:0 8px 0 5px;
	margin: 0px;
}
#ask-answer ul li.last{
	border:none;
}
#ask-answer ul li a{
	color:#FFF;
}
/********
	Ask/Answer Bar switcher
		**********/
#ask-answer.ask .ask{
	background:#99cb04;
	display:block;
}
#ask-answer.ask #ask-answer-nav li.ask a{
	margin-bottom: 10px;
	margin-top: 0px;
}
#ask-answer.answer .answer{
	background:#1b4698;
	display:block;
}
#ask-answer.answer #ask-answer-nav li.answer a{
	margin-top: -3px;
	margin-bottom: 0px;
}

/****
  see  SpecialRecentChanges
******/
.spacelned {
  padding-top:9px;
  line-height:1.8;
}

#rcFilterRow{
	list-style:none;
	margin:0px;
	padding:0px;
}
#rcFilterRow li{
	float:left;
	margin:0px;
	padding:0px;
}

/********
	Answer-tips
		**********/
#answer-tips{
	text-align:right;
	height:20px;
	margin-top:5px;
}
/********
	Contents
		**********/
#contents p {
	margin-bottom:10px;
}
#contents #left-column{
	float:left;
	width:165px;
	text-align:left;
    overflow: hidden;
}
#contents #left-column a {
        color: #003399;
}
#contents #left-column a:visited {
        color: #551a8b;
}
#contents #left-column p iframe {
	width:170px;
}
#contents iframe {
    padding-top: 5px;
    padding-bottom: 5px;
}

/********
	Contents - Left Pod (Registration, etc)
		**********/

div#register-pod,div#login-pod{
	display:none;
	font-family:arial, sans-serif;
	font-size:13px;
}
div.register div#register-pod{
	display:block;
}
div.login div#login-pod{
	display:block;
}

#contents #left-pod{
	width: 165px;
    color:#FFF;
	font-weight:bold;
	overflow: hidden;
	background-color: #003399;
	margin-bottom: 15px;
}
#contents #left-pod #user-pod {
    border-left: 1px solid rgb(185, 185, 185);
    float:left;
    clear:left;
    width: 165px;
}
#contents #left-column p{
	margin:10px;
}
#contents #left-pod #user-pod p{
	margin: 10px 10px 10px 0px;
}

#contents #left-pod a{
	color:#FFF;
}
#contents #left-pod a:visited{
    color:#FFF;
}
#contents #left-pod #left-pod-top{
	float:left;
	display:block;
	height:13px;
	width:11px;
	margin-top:-1px;
	background:url(/templates/images/left-pod-top.gif) no-repeat;
}
#contents #left-pod #left-pod-bottom{
	clear:left;
	float:left;
	display:block;
	height:12px;
	width:11px;
	background:url(/templates/images/left-pod-bottom.gif) no-repeat;
}
#contents #left-pod form{
	text-align:left;
	padding-left:10px;
	margin: 0px;
}
#contents #left-pod form div label{
	display:block;
	margin:10px 0 3px 0;
}
#contents #left-pod form div input{
	width:140px;
}
#contents #left-pod form div.remember-me{
	margin:5px 0 5px 0;
	font-weight:normal;
	position:relative;
}
#contents #left-pod form div.remember-me input{
	width:10px;
}
#contents #left-pod form div.remember-me label{
	display:inline;
}
#contents #left-pod form #login {
	margin: 0px 2px 0px 3px;
}
.IEold #contents #left-pod form #login {
	margin: 0px 6px 0px 0px;
}
.IE8 #contents #left-pod form #login,
.IE7 #contents #left-pod form #login {
	margin: 0px 3px 0px 0px;
}
#contents #left-pod small{
	font-weight:normal;
	display:block;
	width:185px;
}
#contents #left-pod p.sub{
	font-weight:normal;
	margin-top:35px;
	font-size:10px;
}
#contents #left-pod #user-pod p.signIn{
	margin-bottom: -2px;
	margin-top: 0;
	font-size: 15px;
}
#contents #left-pod #user-pod p.signIn img{
	vertical-align: middle;
	margin-top: -6px;
}
/********
	Contents - Left Pod Logged In
		**********/
#contents #left-pod div#logged-in-tools{
	text-align:left;
	padding-left:10px;
	margin-bottom:-15px;
}
#contents #left-pod div#logged-in-tools p{
	margin-left:0;
	padding:0;
	font-family:arial;
	font-size:13px;
}
#contents #left-pod div#logged-in-tools .signOut{
	float:right;
	margin-top:-18px;
	font-size:11px;
	position:relative;
	margin-bottom:0;
}
.IE7 #contents #left-pod div#logged-in-tools .signOut{
	margin-top:-8px;
}
.IEold #contents #left-pod div#logged-in-tools .signOut{
	margin-top:-8px;
	margin-right:4px;
}
#contents #left-pod div#logged-in-tools ul ul{
	margin-top: 5px;
	margin-left:5px;
}
#contents #left-pod div#logged-in-tools li{
	list-style-type:none;
	margin-bottom:20px;
	font-family:arial;
	font-size:13px;
}
#contents #left-pod div#logged-in-tools li li{
	margin-right:10px;
	line-height:13px;
	margin: 0px 0px 1px 0px;
	padding: 1px 0px 1px 5px;
	font-family:arial;
	font-size:12px;
	font-weight:normal;
	opacity:none;
}
.homepage #left-pod #homepage,
.faqArticle #left-pod #faqArticle,
.faqEdit #left-pod #faqEdit,
.faqDiscuss #left-pod #faqDiscuss,
.movepage #left-pod #movepage,
.editRelatedLink #left-pod #editRelatedLink,
.pagehistory #left-pod #pagehistory,
.mergequestion #left-pod #mergequestion,
.revert #left-pod #revert,
.splitQuestion #left-pod #splitQuestion,
.editAlternates #left-pod #editAlternates,
.editRelatedQuestion #left-pod #editRelatedQuestion,
.faqFAQ #left-pod #faqFAQ,
.niSearchResults #left-pod #niSearchResults,
.niSearchResultsTopic #left-pod #niSearchResultsTopic,
.userDiscuss #left-pod #userDiscuss,
.preferences #left-pod #preferences,
.watchlist #left-pod #watchlist,
.unansweredQuestions #left-pod #unansweredQuestions,
.recentQuestions #left-pod #recentQuestions,
.help #left-pod #help,
.Blockip #left-pod #Blockip,
.EditRedirects #left-pod #EditRedirects,
.EditRedirectsTopic #left-pod #EditRedirectsTopic,
.recentChanges #left-pod #recentChanges,
.recentChangesTopic #left-pod #recentChangesTopic,
.FeaturedQuestions #left-pod #FeaturedQuestions,
.topics #left-pod #topics,
.userBio #left-pod #userBio,
.Contributions #left-pod #Contributions,
.SupersForum #left-pod #SupersForum,
.CommunityForum #left-pod #CommunityForum,
.stylebook #left-pod #stylebook{
	margin: 0 0 1px 0;
	padding-left: 5px;
	background-color:#5e7ebf;
	padding-bottom: 1px;
	padding-top: 1px;
}
#contents #left-pod div#logged-in-tools ul ul.lineSeparator{
	border-top:1px #4060A0 solid;
	padding-top:5px;
	margin-top:5px;
}
#contents #left-pod div#logged-in-tools ul ul.content {
	margin-top:0px;
}
#contents #left-pod div#logged-in-tools ul ul.fullLine{
	margin-left:0;
