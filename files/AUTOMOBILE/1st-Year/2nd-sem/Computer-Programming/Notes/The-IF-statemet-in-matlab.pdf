(   )Tj
0 -1.2 TD
(    % Solve the system)Tj
T*
(    y = A\\b;)Tj
T*
(    linear = \(lefty-righty+sin\(leftx\)-sin\(rightx\)\)/\(leftx-rightx\)\;)Tj
T*
(    constant = lefty + sin\(leftx\) - linear*leftx;)Tj
T*
(    true = -sin\(x\) + linear*x + constant;)Tj
0 -2.39999 TD
(    subplot\(1,2,1\);)Tj
0 -1.2 TD
(    plot\(x,y,'go',x,true,'y'\);)Tj
T*
(    title\('True Solution and Approximation'\);)Tj
0 -1.2 TD
(    xlabel\('x'\);)Tj
0 -1.2 TD
(    ylabel\('y'\);)Tj
T*
(    subplot\(1,2,2\);)Tj
T*
(    plot\(x,abs\(y-true\),'cx'\);)Tj
T*
(    title\('Error'\);)Tj
T*
(    xlabel\('x'\);)Tj
T*
(    ylabel\('|Error|'\);)Tj
0 -3.60001 TD
(end)Tj
