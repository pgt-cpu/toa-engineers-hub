(%   ex: [x] = gaussElim\(A,b\))Tj
T*
(%     this will perform Gaussian elminiation to find x.)Tj
T*
(%)Tj
0 -1.20001 TD
(%)Tj
0 -3.60001 TD
( N = max\(size\(A\)\);)Tj
T*
(% Perform Gaussian Elimination)Tj
0 -2.39999 TD
( for j=2:N,)Tj
0 -1.2 TD
(     for i=j:N,)Tj
T*
(        m = A\(i,j-1\)/A\(j-1,j-1\);)Tj
T*
(        A\(i,:\) = A\(i,:\) - A\(j-1,:\)*m;)Tj
T*
(        b\(i\) = b\(i\) - m*b\(j-1\);)Tj
T*
(     end)Tj
T*
( end)Tj
0 -2.40001 TD
(% Perform back substitution)Tj
0 -2.39999 TD
( x = zeros\(N,1\);)Tj
0 -1.2 TD
( x\(N\) = b\(N\)/A\(N,N\);)Tj
0 -2.39999 TD
( for j=N-1:-1:1,)Tj
0 -1.2 TD
(   x\(j\) = \(b\(j\)-A\(j,j+1:N\)*x\(j+1:N\)\)/A\(j,j\);)Tj
T*
( end)Tj
